{
    "name": "aklebe-laravel/mercy-php-deployment",
    "description": "Isolated deployment for your main application.",
    "type": "library",
    "license": "MIT",
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {}
    },
    "require": {
        "php": "^8.5",
        "illuminate/collections": "^13.0",
        "illuminate/support": "^v13.11",
        "laravel/prompts": "^0.3",
        "symfony/console": "^v8.1",
        "symfony/filesystem": "^8.1",
        "symfony/process": "^8.0",
        "symfony/yaml": "^v8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "suggest": {
        "ext-zip": "Needed to create a bundle (build_steps.create_bundle)."
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "AklebeLaravel\\MercyPhpDeployment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AklebeLaravel\\MercyPhpDeployment\\Tests\\": "tests/"
        }
    }
}
